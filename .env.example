# MySQL connection string
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://app:app1234@127.0.0.1:3306/app_db

# NextAuth Config
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Encryption key untuk plain_password (AES-256-GCM)
# Generate dengan: openssl rand -hex 32
ENCRYPTION_KEY="your-64-char-hex-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Nodemailer SMTP (opsional)
SMTP_EMAIL=""
SMTP_PASSWORD=""

# ── BasePath (opsional) ──────────────────────────────────
# Isi jika aplikasi dihosting di sub-path, contoh: /inventaris
# Kosongkan jika pakai subdomain langsung (contoh: inventaris.domain.com)
# NEXT_PUBLIC_BASE_PATH=/inventaris

# URL dasar aplikasi untuk email verifikasi (tanpa trailing slash)
# NEXT_PUBLIC_APP_URL=https://domain.com
